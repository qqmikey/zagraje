# Всё сгенерированное: планы, рендеры, .blend — пересобирается командой make
out/*
# Принятые финальные кадры — в git
!out/final/
output/pdf/*.pdf

# Фото и рефы участка (лежат локально в refs/, в git не идут)
refs/

# Blender: автосохранения и бэкапы
*.blend1
*.blend@

# Python / macOS
__pycache__/
*.pyc
.DS_Store
